    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.24.7",
    "@pinecone-database/pinecone": "^1.1.2",
    "neo4j-driver": "^5.15.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "epub2": "^3.0.2",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
